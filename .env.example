# ==============================================================================
# CosmiChameleon Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Built into client bundle - NEVER put secrets here)
# ------------------------------------------------------------------------------
# Production API Base URL (Leave blank for universal relative /api/contact, or specify HTTPS API host)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# BACKEND / CLOUDFLARE SECRETS (Server-side ONLY - Keep private)
# ------------------------------------------------------------------------------
PORT=3001
ALLOWED_ORIGIN=https://cosmichameleon.com

# Google Sheets Integration (Recommended: Google Apps Script Webhook URL)
GOOGLE_SHEET_WEBHOOK_URL=

# Gmail Notification Integration (App Password via Gmail 2FA)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFICATION_RECIPIENT=hello@cosmichameleon.com
